# Corsair Control - grant the logged-in desktop user access to Corsair
# cooling hardware so the application does not have to run as root.
#
# Install:
#   sudo cp 60-corsair-control.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Then unplug/replug the device or reboot.
#
# TAG+="uaccess" hands access to whoever is logged in on the local seat, which
# is what you want on a single-user desktop. Replace it with GROUP="plugdev"
# if your distribution prefers group-based access.

# Corsair (vendor 1b1c) - raw USB access
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", MODE="0660", TAG+="uaccess"

# Corsair - HID interface used by Commander/Hydro/Elite devices
KERNEL=="hidraw*", ATTRS{idVendor}=="1b1c", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", MODE="0660", TAG+="uaccess"

# Mainboard fan headers live in sysfs (/sys/class/hwmon/*/pwmN) and are
# root-only by design. There is no udev tag that changes that safely, so the
# background service (corsair-controld, running as root) is the supported way
# to control them. Corsair hardware on USB does not need root.

# Corsair AXi / HXi power supplies speak over a serial bridge
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="1c00", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="1c01", MODE="0660", TAG+="uaccess"
